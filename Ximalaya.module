#!name=喜马拉雅时长改写（实验性）
#!desc=将 decreaseDuration / syncListenTime 的 JSON 请求字段 duration 设为 0，并将免费听成功响应的 balance / durationBalance 提高到至少 86400 秒。
#!author=yuxilong
#!category=实验
#!homepage=https://github.com/YuXilong/surge-modules

# 仅处理时长接口；保留失败响应、广告奖励结果及其他权限字段。
# 脚本与模块发布到 main 后，远程安装才能加载本次改动。

[Rule]
# 此域名同时承载时长查询和激励广告；覆盖基础配置中的整域广告拦截。
# 若其他模块也拦截此域名，请调整模块优先级或删除冲突规则。
DOMAIN,adse.ximalaya.com,DIRECT
# 同时放行并解密加速域名。
DOMAIN,adse.wsa.ximalaya.com,DIRECT
DOMAIN,ad-incentive.ximalaya.com,DIRECT

[Script]
ximalaya-decrease-request = type=http-request,pattern=^https?:\/\/adse\.(wsa\.)?ximalaya\.com\/incentive\/ting\/decreaseDuration(\/ts-\d+)?(\?[^#]*)?$,requires-body=1,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_vip.js?v=20260930-2
ximalaya-sync-listen-request = type=http-request,pattern=^https?:\/\/ad-incentive\.ximalaya\.com\/incentive-sync\/ting\/welfare\/syncListenTime(\/ts-\d+)?(\?[^#]*)?$,requires-body=1,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_vip.js?v=20260930-2
ximalaya-free-listen = type=http-response,pattern=^https?:\/\/(adse\.(wsa\.)?ximalaya\.com\/incentive\/ting\/(currentDuration|decreaseDuration|rewardDuration|recAlbumInfo)|ad-incentive\.ximalaya\.com\/incentive-sync\/ting\/welfare\/syncListenTime)(\/ts-\d+)?(\?[^#]*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_vip.js?v=20260930-2

[MITM]
hostname = %APPEND% adse.ximalaya.com, adse.wsa.ximalaya.com, ad-incentive.ximalaya.com
