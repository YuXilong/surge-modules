#!name=喜马拉雅时长改写（实验性）
#!desc=通过域名配置关闭 SDK HTTPDNS，恢复域名请求；将 decreaseDuration / syncListenTime 的 JSON 请求字段 duration 设为 0，并将免费听成功响应的 balance / durationBalance 提高到至少 86400 秒。 过滤开屏和已确认的首页广告；配置密文由 uu.t-wk.com 处理。无需全 IP 解密，更新后冷启动两次。
#!author=yuxilong
#!category=实验
#!homepage=https://github.com/YuXilong/surge-modules

# 处理 HTTPDNS 配置与时长接口；保留失败响应、广告奖励结果及其他权限字段。
# 脚本与模块发布到 main 后，远程安装才能加载本次改动。

[Rule]
# 此域名同时承载时长查询和激励广告；覆盖基础配置中的整域广告拦截。
# 若其他模块也拦截此域名，请调整模块优先级或删除冲突规则。
DOMAIN,adse.ximalaya.com,DIRECT
# 同时放行并解密加速域名。
DOMAIN,adse.wsa.ximalaya.com,DIRECT
DOMAIN,ad-incentive.ximalaya.com,DIRECT

[Script]
ximalaya-ads = type=http-response,pattern=^https?:\/\/(adse\.(wsa\.)?ximalaya\.com(?::(?:80|443))?\/(ting\/loading(\/ts-\d+)?|adx\/ad)|(mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?\/discovery-feed\/v4\/mix(\/ts-\d+)?)(\?[^#]*)?$,requires-body=1,max-size=2097152,timeout=10,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_ads.js?v=20260930-4
# 仅处理两个 HTTPDNS 配置域名：获取完整配置，由 uu.t-wk.com 处理配置密文，本地缓存相同配置。
ximalaya-httpdns-sdk-request = type=http-request,pattern=^https:\/\/gslb(tx|ali)\.ximalaya\.com(?::443)?\/linkeye-cloud\/httpdns\/v3\/init\/\d+(\?[^#]*)?$,timeout=10,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_httpdns.js?v=20260930-4
ximalaya-httpdns-sdk-response = type=http-response,pattern=^https:\/\/gslb(tx|ali)\.ximalaya\.com(?::443)?\/linkeye-cloud\/httpdns\/v3\/init\/\d+(\?[^#]*)?$,requires-body=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_httpdns.js?v=20260930-4
ximalaya-decrease-request = type=http-request,pattern=^https?:\/\/adse\.(wsa\.)?ximalaya\.com\/incentive\/ting\/decreaseDuration(\/ts-\d+)?(\?[^#]*)?$,requires-body=1,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_vip.js?v=20260930-2
ximalaya-sync-listen-request = type=http-request,pattern=^https?:\/\/ad-incentive\.ximalaya\.com\/incentive-sync\/ting\/welfare\/syncListenTime(\/ts-\d+)?(\?[^#]*)?$,requires-body=1,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_vip.js?v=20260930-2
ximalaya-free-listen = type=http-response,pattern=^https?:\/\/(adse\.(wsa\.)?ximalaya\.com\/incentive\/ting\/(currentDuration|decreaseDuration|rewardDuration|recAlbumInfo)|ad-incentive\.ximalaya\.com\/incentive-sync\/ting\/welfare\/syncListenTime)(\/ts-\d+)?(\?[^#]*)?$,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/YuXilong/surge-modules/main/js/ximalaya_vip.js?v=20260930-2

[MITM]
hostname = %APPEND% adse.ximalaya.com, adse.wsa.ximalaya.com, ad-incentive.ximalaya.com, mobile.ximalaya.com, mobilehera.ximalaya.com, mobwsa.ximalaya.com, gslbtx.ximalaya.com, gslbali.ximalaya.com
